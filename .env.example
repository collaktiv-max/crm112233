# Sätts automatiskt om Supabase skapas via Vercel → Storage. Annars: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Antingen anon key eller publishable key räcker:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Endast dessa mejladresser släpps in (kommaseparerat). Stäng även av
# "Allow new users to sign up" i Supabase → Authentication → Providers → Email.
ALLOWED_EMAILS=vilmer@collaktiv.se

# Claude-kopplingen (MCP) – se sidan "Claude" i appen.
# Lång slumpmässig sträng, minst 24 tecken. Ingår i kopplingsadressen och fungerar som lösenord.
MCP_SECRET=
# Kontot Claude agerar som (måste finnas i Supabase Auth).
MCP_USER_EMAIL=vilmer@collaktiv.se
# Sätts automatiskt av Vercels Supabase-koppling, annars Supabase → Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=
